generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  avatar    String?
  role      String   @default("STUDENT") // STUDENT, PROF, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions  TrainingSession[]
  stats     UserStats?
}

model TrainingSession {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Données de la session
  difficulty  String   // "EASY", "MEDIUM", "HARD"
  precision   Float    // Précision en pourcentage (0-100)
  duration    Int      // Durée totale en secondes
  totalImages Int      // Nombre d'images dans la série
  correctAnswers Int   // Nombre de bonnes réponses
  
  // Score et XP
  baseScore   Int      // Score de base avant multiplicateur
  multiplier  Float    // Multiplicateur selon difficulté (1.0, 1.5, 2.0)
  xpEarned    Int      // XP gagnés (baseScore * multiplier)
  
  // Date et heure
  completedAt DateTime @default(now())
}

model UserStats {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // XP et niveau
  totalXp       Int       @default(0)
  level         Int       @default(1)
  
  // Statistiques
  totalSessions Int       @default(0)
  averageScore  Float     @default(0)
  averageTime   Int       @default(0)  // En secondes
  currentStreak Int       @default(0)  // Jours consécutifs
  
  // Dernière activité
  lastActivityAt DateTime?
}
